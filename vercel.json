{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bridgedplatforms.co.za" }],
      "destination": "https://www.bridgedplatforms.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bridged-platforms.vercel.app" }],
      "destination": "https://www.bridgedplatforms.co.za/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
